# Copy to .env for `netlify dev`; set the real values as secret env vars in Netlify. Never commit .env.
# Naming follows templates/env.example: <VENDOR>_<PURPOSE>.

# --- Supabase ---
PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
PUBLIC_SUPABASE_ANON_KEY=<anon-key>
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>          # functions only
NOTIFY_WEBHOOK_SECRET=<long-random-string>             # sent by Supabase Database Webhooks as x-webhook-secret

# --- Texts (Twilio) — register the Messaging Service for US A2P 10DLC before launch ---
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_MESSAGING_SERVICE_SID=MG...

# --- Email (Resend) ---
RESEND_API_KEY=re_...
EMAIL_FROM="Ellis Adventures <hello@yourdomain.com>"
EMAIL_REPLY_TO=Hello@thekelseyellisadventure.com

# --- Scheduling (Cal.com API v2) ---
CAL_API_KEY=cal_live_...
# host:minutes -> Cal.com event type id. "both" = a collective event type on both calendars.
CAL_EVENT_TYPES={"both:30":0,"both:45":0,"both:60":0,"kelsey:30":0,"kelsey:45":0,"kelsey:60":0,"zach:30":0,"zach:45":0,"zach:60":0}

# --- Instagram API with Instagram Login (one long-lived token per professional account) ---
IG_TOKEN_KELSEY=...
IG_TOKEN_ZACH=...
IG_GRAPH_VERSION=v23.0

# --- Claude (scores Instagram comments for the audience wall) ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Abuse protection for the public inquiry form (REQUIRED: the function refuses submissions without them) ---
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Key for hashing client IPs for rate limiting. Generate with: openssl rand -hex 32
IP_HASH_SALT=
# Local `netlify dev` only. Never set this in Netlify: it disables the bot check and IP rate limit.
# INQUIRY_CHECKS_DISABLED_FOR_LOCAL_DEV=true
