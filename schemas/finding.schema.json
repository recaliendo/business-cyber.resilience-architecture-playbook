{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "ruleId": {
      "type": "string"
    },
    "ruleVersion": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "domains": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "infrastructure",
          "capacity",
          "security",
          "compliance",
          "geo",
          "repository"
        ]
      }
    },
    "category": {
      "type": "string"
    },
    "affected": {
      "type": "object",
      "properties": {
        "assets": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "controls": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "files": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "severity": {
      "type": "string",
      "enum": [
        "critical",
        "high",
        "medium",
        "low",
        "info"
      ]
    },
    "priority": {
      "type": "string",
      "enum": [
        "P0",
        "P1",
        "P2",
        "P3"
      ]
    },
    "confidence": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "confirmed",
        "suspected",
        "requires_verification"
      ]
    },
    "provenance": {
      "type": "string",
      "enum": [
        "observed",
        "self_reported",
        "inferred",
        "unknown"
      ]
    },
    "evidenceLevel": {
      "type": "string",
      "enum": [
        "source_code",
        "declared_config",
        "deployed_evidence",
        "self_reported",
        "none"
      ]
    },
    "observed": {
      "type": "string"
    },
    "expected": {
      "type": "string"
    },
    "scenario": {
      "type": "string"
    },
    "businessImpact": {
      "type": "string"
    },
    "insights": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "assumptions": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "limitations": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "evidence_item",
              "source_file",
              "config",
              "measurement",
              "intake_field",
              "external_reference"
            ]
          },
          "ref": {
            "type": "string"
          },
          "collectedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          },
          "url": {
            "type": "string"
          },
          "line": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "kind",
          "ref"
        ]
      }
    },
    "references": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "sourceId": {
            "type": "string"
          }
        },
        "required": [
          "title",
          "url"
        ]
      }
    },
    "remediation": {
      "type": "object",
      "properties": {
        "summary": {
          "type": "string"
        },
        "steps": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "alternatives": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "illustrativeCode": {
          "type": "string"
        },
        "files": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rollout": {
          "type": "string"
        }
      },
      "required": [
        "summary"
      ]
    },
    "ownerRole": {
      "type": "string"
    },
    "effortHours": {
      "type": "object",
      "properties": {
        "low": {
          "type": "number",
          "minimum": 0
        },
        "high": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "low",
        "high"
      ]
    },
    "costUsd": {
      "type": "object",
      "properties": {
        "low": {
          "type": "number",
          "minimum": 0
        },
        "high": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "low",
        "high"
      ]
    },
    "dependencies": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "validation": {
      "type": "string"
    },
    "acceptanceCriteria": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "applicableStage": {
      "type": "string",
      "enum": [
        "prelaunch",
        "launch",
        "early_production",
        "growth",
        "enterprise_global"
      ]
    },
    "reassessWhen": {
      "type": "string"
    },
    "launchBlocker": {
      "default": false,
      "type": "boolean"
    },
    "vendorOptions": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "addresses": {
            "type": "string"
          },
          "whyNotNative": {
            "type": "string"
          },
          "retainedResponsibilities": {
            "type": "string"
          },
          "stageFit": {
            "type": "string"
          },
          "pricingNote": {
            "type": "string"
          },
          "limitations": {
            "type": "string"
          },
          "docsUrl": {
            "type": "string"
          },
          "lowerCostAlternative": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "addresses",
          "whyNotNative",
          "retainedResponsibilities",
          "stageFit",
          "pricingNote",
          "limitations"
        ]
      }
    },
    "prompt": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "path",
        "text"
      ]
    }
  },
  "required": [
    "id",
    "ruleId",
    "ruleVersion",
    "title",
    "domains",
    "category",
    "affected",
    "severity",
    "priority",
    "confidence",
    "status",
    "provenance",
    "evidenceLevel",
    "observed",
    "expected",
    "scenario",
    "businessImpact",
    "remediation",
    "ownerRole",
    "effortHours",
    "validation",
    "applicableStage",
    "reassessWhen"
  ]
}
