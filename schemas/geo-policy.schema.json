{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "policyId": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "businessModel": {
      "type": "string",
      "enum": [
        "b2c",
        "b2b",
        "hybrid"
      ]
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(SAN|THR)-[A-Z0-9-]+$"
          },
          "track": {
            "type": "string",
            "enum": [
              "sanctions",
              "threat"
            ]
          },
          "selector": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "country"
                  },
                  "code": {
                    "type": "string",
                    "pattern": "^[A-Z]{2}$"
                  }
                },
                "required": [
                  "type",
                  "code"
                ]
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "subdivision"
                  },
                  "code": {
                    "type": "string",
                    "pattern": "^[A-Z]{2}-[A-Z0-9]{1,3}$"
                  }
                },
                "required": [
                  "type",
                  "code"
                ]
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "territory"
                  },
                  "legalDescription": {
                    "type": "string",
                    "minLength": 10
                  },
                  "country": {
                    "type": "string",
                    "pattern": "^[A-Z]{2}$"
                  },
                  "approximateSubdivisions": {
                    "default": [],
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[A-Z]{2}-[A-Z0-9]{1,3}$"
                    }
                  },
                  "mappingNote": {
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "legalDescription",
                  "country",
                  "mappingNote"
                ]
              }
            ]
          },
          "action": {
            "type": "string",
            "enum": [
              "BLOCK",
              "CHALLENGE",
              "MONITOR"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 5
          },
          "legalBasis": {
            "type": "string"
          },
          "sourceRefs": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "confidence": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "dateAdded": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
          },
          "effectiveDate": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
          },
          "reviewDate": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          },
          "clients": {
            "default": [
              "web",
              "ios",
              "api"
            ],
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "web",
                "ios",
                "api"
              ]
            }
          },
          "exceptions": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "rollback": {
            "default": "Revert the policy commit; redeploy the previous approved artifact.",
            "type": "string"
          },
          "counselReviewed": {
            "default": false,
            "type": "boolean"
          },
          "synthetic": {
            "default": false,
            "description": "True for examples/tests. Synthetic rules are refused by enforcement planning unless --allow-synthetic.",
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "track",
          "selector",
          "action",
          "reason",
          "confidence",
          "dateAdded",
          "effectiveDate",
          "reviewDate"
        ]
      }
    },
    "quarterlyReviewDue": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    }
  },
  "required": [
    "policyId",
    "version",
    "businessModel",
    "rules",
    "quarterlyReviewDue"
  ]
}
