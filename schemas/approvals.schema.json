{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "approvals": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "policyId": {
            "type": "string"
          },
          "policyVersion": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "policyHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "approver": {
            "type": "string"
          },
          "approvedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          },
          "changeRef": {
            "type": "string",
            "description": "PR URL or commit SHA that carried the reviewed change"
          },
          "method": {
            "type": "string",
            "enum": [
              "github_pr_review",
              "signed_commit",
              "manual_record"
            ]
          }
        },
        "required": [
          "id",
          "policyId",
          "policyVersion",
          "policyHash",
          "approver",
          "approvedAt",
          "changeRef",
          "method"
        ]
      }
    }
  },
  "required": [
    "approvals"
  ]
}
